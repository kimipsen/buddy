    "role_list",
    "saml_organization",
    "AuthnContextClassRef",
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "basic"
  ],
  "defaultOptionalClientScopes": ["buddy-mcp:read"],
  "clientProfiles": {
    "profiles": [
      {
        "name": "buddy-mcp-dcr",
        "description": "Clients that register themselves: PKCE S256, no implicit or password grant",
        "executors": [
          {
            "executor": "pkce-enforcer",
            "configuration": {
              "auto-configure": true
            }
          },
          {
            "executor": "reject-implicit-grant",
            "configuration": {
              "auto-configure": true
            }
          },
          {
            "executor": "reject-ropc-grant",
            "configuration": {
              "auto-configure": true
            }
          }
        ]
      },
      {
        "name": "buddy-mcp-no-secrets",
        "description": "Refuses a confidential client: no secret is ever handed out",
        "executors": [
          {
            "executor": "reject-request",
            "configuration": {}
          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "buddy-mcp-dcr",
        "description": "Applies to clients registered anonymously",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-updater-context",
            "configuration": {
              "update-client-source": ["ByAnonymous"]
            }
          }
        ],
        "profiles": ["buddy-mcp-dcr"]
      },
      {
        "name": "buddy-mcp-public-only",
        "description": "Anonymous registrations must be public clients",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-updater-context",
            "configuration": {
              "update-client-source": ["ByAnonymous"]
            }
          },
          {
            "condition": "client-scopes",
            "configuration": {
              "type": "optional",
              "scope": ["buddy-mcp:read"]
            }
          },
          {
            "condition": "client-access-type",
            "configuration": {
              "type": ["confidential"]
            }
          }
        ],
        "profiles": ["buddy-mcp-no-secrets"]
      }
    ]
  }
