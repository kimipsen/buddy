# Copy to deploy/.env (gitignored) and fill in real values before first deploy.

# Hostname of the production VM (output of `hostname` on the VM). `task deploy`
# refuses to run anywhere else, see preflight.sh.
DEPLOY_HOST=your-vm-hostname

# Public domains — must have DNS A records pointing at the VM's public IP
API_DOMAIN=api.yourdomain.com
AUTH_DOMAIN=auth.yourdomain.com
APP_DOMAIN=app.yourdomain.com

# Optional: the "GitHub" link in the profile menu. Set it if you run your own
# fork; blank keeps https://github.com/kimipsen/buddy.
REPOSITORY_URL=

# Optional: turn off features this installation doesn't use. Every feature is
# on unless set to false here; the API reads these directly (env_file), and the
# app hides what is off. A disabled feature's data is kept, still exported and
# erased, and back as it was when you turn it on again. A misspelt name stops
# the API from starting. See docs/backend/analysis/feature-flags.md.
# Features__Mealplans=false
# Features__MealplanAiAssistant=false
# Features__MealplanImport=false
# Features__Medicines=false
# Features__SleepDiary=false
# Features__Pickups=false
# Features__Babysitters=false
# Features__WorkLocations=false
# Features__Printing=false
# Features__Progress=false
# Features__TaskLibrary=false
# Features__Help=false

# PostgreSQL (shared instance; app db + keycloak db, see init-keycloak-db.sql)
# Postgres runs with the default max_connections=100, shared by the API and
# Keycloak. The API holds at most 50 (one shared pool, default Maximum Pool
# Size=50); to change that, append ";Maximum Pool Size=N" to
# ConnectionStrings__Postgres in docker-compose.prod.yml. See README.md
# "Database connections".
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=buddy

# Keycloak admin console
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Secret for the buddy-admin-cli client (create/rotate in the Keycloak admin
# console under Clients > buddy-admin-cli > Credentials, then paste it here)
KEYCLOAK_ADMIN_CLI_SECRET=change-me
