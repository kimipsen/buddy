@buddy_HostAddress = http://localhost:5193
@keycloak_HostAddress = http://keycloak:8080
@keycloak_realm = buddy
@keycloak_client_id = buddy-frontend
@keycloak_username = alice
@keycloak_password = alice-test-pw

GET {{buddy_HostAddress}}/openapi/v1.json
Accept: application/json

###

GET {{buddy_HostAddress}}/openapi/users.json
Accept: application/json

###

# @name login
POST {{keycloak_HostAddress}}/realms/{{keycloak_realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id={{keycloak_client_id}}&grant_type=password&username={{keycloak_username}}&password={{keycloak_password}}

###

GET {{buddy_HostAddress}}/users/me
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

###

PATCH {{buddy_HostAddress}}/users/me/name
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json
Accept: application/json

{
  "givenName": "Alice",
  "familyName": "Anderson"
}

###

PATCH {{buddy_HostAddress}}/users/me/email
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json
Accept: application/json

{
  "email": "alice@buddy.test"
}

###

POST {{buddy_HostAddress}}/users/me/email/verify/resend
Authorization: Bearer {{login.response.body.$.access_token}}

###

# Token comes from the message received in Mailpit (http://localhost:9025).
POST {{buddy_HostAddress}}/users/me/email/verify
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json
Accept: application/json

{
  "token": "SdGdZbQXIMpvMsc5Hfa8apDGqBY5wHoW_ONxt5oakbQ"
}

###

DELETE {{buddy_HostAddress}}/users/me
Authorization: Bearer {{login.response.body.$.access_token}}


###

# What deleting the account would also take with it: children with no other guardian, owned groups.
GET {{buddy_HostAddress}}/users/me/deletion-preview
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

###

# Download everything Buddy holds about you and the children you guard (one per 10 minutes).
GET {{buddy_HostAddress}}/users/me/export
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

###

# Erase a child's account and data -- only the child's sole guardian (409 child_has_other_guardians otherwise).
@childId = 00000000-0000-0000-0000-000000000000
DELETE {{buddy_HostAddress}}/users/me/children/{{childId}}
Authorization: Bearer {{login.response.body.$.access_token}}

GET {{buddy_HostAddress}}/users/me/onboarding
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

###

PUT {{buddy_HostAddress}}/users/me/onboarding
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "status": 2,
  "setupGroupId": null,
  "invitationsSkipped": false,
  "version": 0
}

###

# Turn a child's visual time-left timers off (or on) -- any active guardian of the child.
PATCH {{buddy_HostAddress}}/users/me/children/{{childId}}/visual-timers
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "showVisualTimers": false
}

###

# Set a child's homework focus and break lengths in minutes (focus 5-45, break 1-15; default
# 15/5) -- any active guardian of the child. Only mapped when Features:Homework is on.
PATCH {{buddy_HostAddress}}/users/me/children/{{childId}}/homework-chunks
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: application/json

{
  "focusMinutes": 10,
  "breakMinutes": 3
}

###
