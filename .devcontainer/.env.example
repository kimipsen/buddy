# Template for .devcontainer/.env — copy it before starting the devcontainer:
#   cp .devcontainer/.env.example .devcontainer/.env
# The real .env is gitignored; never commit credentials.

# PostgreSQL (db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Keycloak admin console
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Keycloak -> PostgreSQL login (must match POSTGRES_USER/POSTGRES_PASSWORD)
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=change-me
