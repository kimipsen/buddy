@buddy_HostAddress = http://localhost:5193

### Create a reusable task template for a child (guardian only)

POST {{buddy_HostAddress}}/task-templates/children/{{childId}}
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "Name": "Morning routine",
  "Icon": "sunrise",
  "Color": "#ffaa00"
}

###

# List a child's task template library (guardian or child)
GET {{buddy_HostAddress}}/task-templates/children/{{childId}}
Authorization: Bearer {{guardianToken}}

###

# Update a template's name/icon/color (guardian only)
PATCH {{buddy_HostAddress}}/task-templates/{{templateId}}
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "Name": "Morning routine (weekdays)",
  "Icon": "sunrise",
  "Color": "#ffaa00"
}

###

# Add a subtask to a template (guardian only)
POST {{buddy_HostAddress}}/task-templates/{{templateId}}/subtasks
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "Title": "Brush teeth",
  "Icon": "toothbrush",
  "Duration": "00:02:00",
  "Position": null
}

###

# Update a subtask (guardian only)
PATCH {{buddy_HostAddress}}/task-templates/{{templateId}}/subtasks/{{subtaskId}}
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "Title": "Brush teeth thoroughly",
  "Icon": "toothbrush",
  "Duration": "00:03:00"
}

###

# Reorder a template's subtasks (guardian only)
PUT {{buddy_HostAddress}}/task-templates/{{templateId}}/subtasks/order
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "NewOrder": ["{{subtaskId2}}", "{{subtaskId}}"]
}

###

# Remove a subtask (guardian only)
DELETE {{buddy_HostAddress}}/task-templates/{{templateId}}/subtasks/{{subtaskId}}
Authorization: Bearer {{guardianToken}}

###

# Archive a template (guardian only) -- soft "delete", stays in the library
DELETE {{buddy_HostAddress}}/task-templates/{{templateId}}
Authorization: Bearer {{guardianToken}}

###

# Create a packing list (checklist) shown the evening before from 17:00 (guardian only)
POST {{buddy_HostAddress}}/task-templates/children/{{childId}}
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "Name": "School bag",
  "Icon": "🎒",
  "Color": "#3355ff",
  "Kind": "Checklist",
  "EveningBeforeFrom": "17:00:00"
}

###

# Add a packing-list item that only applies on Tuesdays (no duration for a checklist)
POST {{buddy_HostAddress}}/task-templates/{{templateId}}/subtasks
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "Title": "Gym clothes",
  "Weekdays": ["Tuesday"]
}

###

# Change when a packing list shows the evening before; null shows it on the day only (guardian only)
PUT {{buddy_HostAddress}}/task-templates/{{templateId}}/checklist-options
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "EveningBeforeFrom": "18:30:00"
}

###

# Copy a template (routine or packing list) to another child (guardian of both)
POST {{buddy_HostAddress}}/task-templates/{{templateId}}/copy
Authorization: Bearer {{guardianToken}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "ChildId": "{{siblingId}}"
}

###

# Suggest an item for your own packing list (the owning child only)
POST {{buddy_HostAddress}}/task-templates/{{templateId}}/suggestions
Authorization: Bearer {{childToken}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "Title": "Recorder",
  "Weekdays": ["Friday"]
}

###

# Take back your own pending suggestion (the owning child only)
POST {{buddy_HostAddress}}/task-templates/{{templateId}}/suggestions/{{suggestionId}}/withdraw
Authorization: Bearer {{childToken}}

###

# Approve a suggestion with the guardian's final title and days (guardian only)
POST {{buddy_HostAddress}}/task-templates/{{templateId}}/suggestions/{{suggestionId}}/approve
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "Title": "Recorder",
  "Weekdays": ["Friday"],
  "Position": null
}

###

# Decline a suggestion (guardian only)
POST {{buddy_HostAddress}}/task-templates/{{templateId}}/suggestions/{{suggestionId}}/decline
Authorization: Bearer {{guardianToken}}

###
