{$API_DOMAIN} {
	# The API sets its own security headers (Common/Http/SecurityHeadersMiddleware.cs), so they
	# apply on Azure too, which has no proxy to add them. The app's live in
	# src/frontend/buddy/Caddyfile; Keycloak sends its own (realm Security Defenses).
	reverse_proxy api:8080
}

{$AUTH_DOMAIN} {
	reverse_proxy keycloak:8080
}

{$APP_DOMAIN} {
	reverse_proxy frontend:80
}
