@buddy_HostAddress = http://localhost:5193

### Assign Monday's drop-off to a guardian (guardian only)

PUT {{buddy_HostAddress}}/pickups/children/{{childId}}/assignments?date=2025-06-02&slot=DropOff
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "assignee": { "kind": 0, "guardianId": "{{guardianId}}" },
  "time": "08:00:00",
  "notes": "Bring an umbrella"
}

###

# Assign Monday's pickup to self-escort (guardian only)
PUT {{buddy_HostAddress}}/pickups/children/{{childId}}/assignments?date=2025-06-02&slot=PickUp
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "assignee": { "kind": 1 }
}

###

# Assign Tuesday's pickup to a sibling escort (guardian only)
PUT {{buddy_HostAddress}}/pickups/children/{{childId}}/assignments?date=2025-06-03&slot=PickUp
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "assignee": { "kind": 2, "siblingChildId": "{{siblingChildId}}" }
}

###

# Assign Wednesday's pickup to a playdate (guardian only)
PUT {{buddy_HostAddress}}/pickups/children/{{childId}}/assignments?date=2025-06-04&slot=PickUp
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "assignee": { "kind": 3, "hostName": "Mia's mom", "location": "Mia's house", "contactInfo": "+45 12 34 56 78" }
}

###

# Assign Thursday's pickup to a saved babysitter (guardian only). guardianId is whose list the
# babysitter is on (GET /babysitters/children/{childId}); "name" comes back resolved.
PUT {{buddy_HostAddress}}/pickups/children/{{childId}}/assignments?date=2025-06-05&slot=PickUp
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "assignee": { "kind": 4, "guardianId": "{{guardianId}}", "babysitterId": "{{babysitterId}}" }
}

###

# Clear a slot (guardian only)
DELETE {{buddy_HostAddress}}/pickups/children/{{childId}}/assignments?date=2025-06-04&slot=PickUp
Authorization: Bearer {{guardianToken}}

###

# List a child's pickup schedule in a date range (child or guardian)
GET {{buddy_HostAddress}}/pickups/children/{{childId}}/schedule?from=2025-06-02&to=2025-06-06
Authorization: Bearer {{childToken}}
