@buddy_HostAddress = http://localhost:5193

### Create a reusable meal for a child (guardian only)

POST {{buddy_HostAddress}}/mealplans/children/{{childId}}/meals
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "Name": "Tacos",
  "Description": "Ground beef, tortillas, salsa",
  "Icon": "taco",
  "Color": "#ffaa00"
}

###

# List a child's meal library (guardian or child)
GET {{buddy_HostAddress}}/mealplans/children/{{childId}}/meals
Authorization: Bearer {{guardianToken}}

###

# The child rates a meal (child only)
PUT {{buddy_HostAddress}}/mealplans/children/{{childId}}/meals/{{mealId}}/rating
Authorization: Bearer {{childToken}}
Content-Type: application/json

{
  "Stars": 5,
  "Comment": "Loved it!"
}

###

# Assign a meal to a slot on the plan (guardian only)
PUT {{buddy_HostAddress}}/mealplans/children/{{childId}}/plan?date=2025-06-01&slot=Dinner
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "MealId": "{{mealId}}",
  "Notes": "No cilantro"
}

###

# List a child's plan in a date range (guardian or child)
GET {{buddy_HostAddress}}/mealplans/children/{{childId}}/plan?from=2025-06-01&to=2025-06-07
Authorization: Bearer {{childToken}}

###

# Clear a planned slot (guardian only)
DELETE {{buddy_HostAddress}}/mealplans/children/{{childId}}/plan?date=2025-06-01&slot=Dinner
Authorization: Bearer {{guardianToken}}

###

# Preview an import of an older plan (guardian only; writes nothing). Format: "auto" (default),
# "weekly-note" or "csv". WeekStart: 0 = Sunday (default), 1 = Monday. Slot: 2 = Dinner (default).
POST {{buddy_HostAddress}}/mealplans/children/{{childId}}/imports/preview
Authorization: Bearer {{guardianToken}}
Content-Type: application/json

{
  "Text": "Madplan 2024\nU3\nSø: Lasagne\nMa: Hotdogs 🌭\nTi: Rester\nOn: Sushi / McD",
  "Format": "auto"
}

###

# Commit a reviewed import (guardian only). Each entry is an existing MealId or a NewMealName.
POST {{buddy_HostAddress}}/mealplans/children/{{childId}}/imports
Authorization: Bearer {{guardianToken}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "Format": "weekly-note",
  "ArchiveSingleUse": true,
  "Entries": [
    { "Date": "2024-01-14", "Slot": 2, "MealId": "{{mealId}}" },
    { "Date": "2024-01-15", "Slot": 2, "NewMealName": "Hotdogs" },
    { "Date": "2024-01-17", "Slot": 2, "NewMealName": "Sushi", "Notes": "Sushi / McD" }
  ]
}

###

# List a family's imports (guardian only)
GET {{buddy_HostAddress}}/mealplans/children/{{childId}}/imports
Authorization: Bearer {{guardianToken}}

###

# Undo an import: clears only the slots that still hold what it imported (guardian only)
DELETE {{buddy_HostAddress}}/mealplans/children/{{childId}}/imports/{{importId}}
Authorization: Bearer {{guardianToken}}

###
