# Copy to deploy/azure/.env (gitignored) and fill in real values before
# running deploy.sh.

# Where things get created
RESOURCE_GROUP=buddy-rg
LOCATION=swedencentral

# Must be globally unique across all of Azure, lowercase alphanumeric only
ACR_NAME=buddyacrchangeme
PG_SERVER_NAME=buddy-pg-changeme

CONTAINERAPPS_ENV=buddy-env

# PostgreSQL Flexible Server (shared instance; app db + keycloak db)
PG_ADMIN_USER=pgadmin
PG_ADMIN_PASSWORD=change-me
APP_DB_NAME=buddy

# Keycloak admin console
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Secret for the buddy-admin-cli client. A placeholder is fine on first boot —
# see step 5 in README-azure.md for generating and rotating the real one.
KEYCLOAK_ADMIN_CLI_SECRET=change-me

# Custom domains (all optional). Leave blank to use the *.azurecontainerapps.io
# domains Azure assigns automatically - that's the default and what deploy.sh
# uses on a first run. Fill these in later and rerun deploy.sh to bind your
# own domains instead; see "Custom domains" in README-azure.md for the DNS
# records you need to create first.
FRONTEND_CUSTOM_DOMAIN=
API_CUSTOM_DOMAIN=
KEYCLOAK_CUSTOM_DOMAIN=
