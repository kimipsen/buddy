<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings for dotnet test (passed with the settings option; CI: backend-tests.yml).
     Measures the API assembly only; generated code (source generators, Wolverine/Marten codegen
     types marked as generated) doesn't count. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[buddy]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
