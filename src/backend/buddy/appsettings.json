{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Keycloak": {
      "Authority": "http://keycloak:8080/realms/buddy",
      "Audience": "buddy-api",
      "RequireHttpsMetadata": false
    },
    "KeycloakAdmin": {
      "Realm": "buddy",
      "TokenEndpoint": "http://keycloak:8080/realms/buddy/protocol/openid-connect/token",
      "AdminBaseUrl": "http://keycloak:8080/admin/realms/buddy",
      "ClientId": "buddy-admin-cli",
      "ClientSecret": ""
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "Mail": {
    "Host": "mailpit",
    "Port": 1025,
    "UseSsl": false,
    "FromAddress": "no-reply@buddy.local",
    "FrontendBaseUrl": "http://localhost:4300"
  },
  "ConnectionStrings": {
    "Postgres": "Host=...;Port=...;Database=...;Username=...;Password=..."
  },
  "AllowedHosts": "*"
}
