// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet-postgres
{
	"name": "The Buddy System",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4": {
			"moby": "false"
		},
		"ghcr.io/flexwie/devcontainer-features/op:1": {},
		"ghcr.io/dotnet/aspire-devcontainer-feature/dotnetaspire:1": {},
		"ghcr.io/devcontainers-extra/features/claude-code:2": {},
		// "ghcr.io/devcontainer-config/features/dot-config:4": {},
		"ghcr.io/sliekens/devcontainer-features/codex:1": {},
		"ghcr.io/rosstaco/devcontainer-features/copilot-persistence:1": {},
		"ghcr.io/devcontainers/features/node:2": {
			"version": "lts",
			"npmVersion": "lts"
		},
		"ghcr.io/nlstn/devcontainer-features/psql:1": {},
		"ghcr.io/devcontainers-extra/features/go-task:1": {},
		"ghcr.io/devcontainers-extra/features/angular-cli:2": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"SonarSource.sonarlint-vscode",
				"cweijan.vscode-redis-client",
				"humao.rest-client",
				"Angular.ng-template"
			]
		}
	},
	"forwardPorts": [4200, 5193, 7076]
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	// Configure tool-specific properties.
	// "customizations": {},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [500PackageVersion0, 5001, 5432],
	// "portsAttributes": {
	//		"5001": {
	//			"protocol": "https"
	//		}
	// }
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "dotnet --info",
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}