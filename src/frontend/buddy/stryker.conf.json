{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "NG_BUILD_TYPE_CHECK=0 npm test -- --watch=false"
  },
  "coverageAnalysis": "off",
  "timeoutMS": 60000,
  "concurrency": 4,
  "checkers": ["typescript"],
  "typescriptChecker": {
    "prioritizePerformanceOverAccuracy": true
  },
  "mutate": ["src/app/**/*.ts", "!src/app/**/*.spec.ts", "!src/app/core/i18n/translations/**"],
  "reporters": ["progress", "clear-text", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
