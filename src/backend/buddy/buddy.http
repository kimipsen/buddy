@buddy_HostAddress = http://localhost:5193
@keycloak_HostAddress = http://keycloak:8080
@keycloak_realm = buddy
@keycloak_client_id = buddy-api
@keycloak_username = kim.ipsen
@keycloak_password = starspy

GET {{buddy_HostAddress}}/openapi/v1.json
Accept: application/json

###

GET {{buddy_HostAddress}}/openapi/users.json
Accept: application/json

###

# @name login
POST {{keycloak_HostAddress}}/realms/{{keycloak_realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id={{keycloak_client_id}}&grant_type=password&username={{keycloak_username}}&password={{keycloak_password}}

###

GET {{buddy_HostAddress}}/users/me
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

###

GET {{buddy_HostAddress}}/users/me/events
Authorization: Bearer {{login.response.body.$.access_token}}
Accept: application/json

###

DELETE {{buddy_HostAddress}}/users/me
Authorization: Bearer {{login.response.body.$.access_token}}

