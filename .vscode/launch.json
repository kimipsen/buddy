{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Buddy",
      "type": "pwa-chrome",
      "request": "launch",
      "preLaunchTask": "ng serve",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/src/frontend/buddy",
      "sourceMaps": true
    },
    {
      "name": "Attach to Buddy",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src/frontend/buddy",
      "sourceMaps": true
    },
    {
      "name": "Debug Buddy Tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["test", "--", "--watch=false"],
      "cwd": "${workspaceFolder}/src/frontend/buddy",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Buddy: Serve and Debug",
      "configurations": ["Debug Buddy"]
    }
  ]
}
